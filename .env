ENVIRONMENT=local
APP_URL=http://127.0.0.1:5173/
POS_USERNAME=0000
POS_PASSWORD=0000

# ── Local Electron testing (optional) ────────────────────────────────────────
# To run tests against a locally running Electron app (same as hardware mode):
#   1. Launch Electron with --remote-debugging-port=9222
#   2. Uncomment the line below
# CDP_URL=http://localhost:9222

# Set SLOW_MO=0 to disable browser animation delays (faster for perf tests)
# Leave unset (default: 80ms) for normal e2e runs so actions are visible
SLOW_MO=

# ── Performance SLO thresholds (ms) ─────────────────────────────────────────
# SLO (Service Level Objective) = the maximum allowed response time for each
# action. If the actual time exceeds this value the test is flagged as SLOW
# (⚠️) in the report. Tests still pass — SLOs are non-blocking warnings.
# Source: QCOE Target SLO (modern CPU i3-6100TE+)
#
# SLO_SCAN_MS            — max allowed time per item scan (2-300 items)
# SLO_DISCOUNT_DIALOG_MS — max allowed time to open and confirm discount dialog
# SLO_CHECKOUT_MS        — max allowed time for total checkout/payment flow
SLO_SCAN_MS=500
SLO_DISCOUNT_DIALOG_MS=1000
SLO_CHECKOUT_MS=4000

# ── Email notification (set SEND_EMAIL=true to enable) ──────────────────────
SEND_EMAIL=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=recipient1@company.com,recipient2@company.com
EMAIL_SUBJECT=Voyix POS E2E Test Results

# ── CDP mode: connect to an existing browser instead of launching a new one ──
# Use this when testing a Tauri app or any app running in a local browser.
# The target browser must be started with --remote-debugging-port=<PORT>.
# Leave empty (default) to launch a new Chromium browser automatically.
# Example: CDP_URL=http://localhost:9222
CDP_URL=
