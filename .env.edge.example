# ─────────────────────────────────────────────────────────────────────────────
# .env.edge.example  —  Edge / hardware server configuration
#
# Copy to .env.edge and fill in the real values:
#   cp .env.edge.example .env.edge
#
# Usage with docker compose:
#   docker compose --env-file .env.edge --profile edge up --build
#
# Usage with docker run:
#   docker run --rm --env-file .env.edge \
#     -v "$(pwd)/reports:/home/pwuser/app/reports" \
#     voyix-pos-tests:latest
#
# .env.edge is gitignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Target POS Application ────────────────────────────────────────────────────
# URL of the POS app running on the edge/hardware Linux server
# Replace with the actual IP or hostname of your edge device
EDGE_APP_URL=http://192.168.1.100:5173/

# Also used for plain docker run (entrypoint reads APP_URL directly)
APP_URL=http://192.168.1.100:5173/

# ── POS Credentials ───────────────────────────────────────────────────────────
POS_USERNAME=0000
POS_PASSWORD=0000

# ── Browser ───────────────────────────────────────────────────────────────────
HEADLESS=true
SLOW_MO=0

# ── Environment label (shown in HTML report) ──────────────────────────────────
ENVIRONMENT=edge

# ── Performance SLOs (milliseconds) ──────────────────────────────────────────
SLO_SCAN_MS=500
SLO_DISCOUNT_DIALOG_MS=1000
SLO_CHECKOUT_MS=4000

# ── Email notification ────────────────────────────────────────────────────────
SEND_EMAIL=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=recipient@company.com
EMAIL_SUBJECT=Voyix POS E2E Test Results - Edge
