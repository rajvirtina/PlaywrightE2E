# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  copy this file to .env and fill in your values
#
#   cp .env.example .env
#
# .env is gitignored and never committed. .env.example is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# URL of the running Voyix POS app
APP_URL=http://127.0.0.1:5173/

# POS login credentials
POS_USERNAME=0000
POS_PASSWORD=0000

# ── Browser ───────────────────────────────────────────────────────────────────
# Which browser Playwright launches (only applies when CDP_URL is not set):
#   chromium  — default, use for Electron testing or plain Chromium
#   webkit    — Playwright's bundled WebKit, use for Tauri on Linux
BROWSER=chromium

# Set to "true" to run headless (auto-set on Linux/CX7)
HEADLESS=false

# Slow down Playwright clicks by N ms (0 = fastest, 200 = good for demos)
SLOW_MO=80

# ── Environment label ─────────────────────────────────────────────────────────
# Shown in the HTML report header
ENVIRONMENT=local

# ── Performance SLOs (milliseconds) ──────────────────────────────────────────
# Maximum acceptable average time per item scan
SLO_SCAN_MS=500

# Maximum acceptable time for the discount dialog (open → confirm)
SLO_DISCOUNT_DIALOG_MS=1000

# Maximum acceptable total transaction time
SLO_CHECKOUT_MS=120000

# ── Email notification (optional) ─────────────────────────────────────────────
# Set to "true" to email the HTML report after each run
SEND_EMAIL=false

# SMTP settings (only needed when SEND_EMAIL=true)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASS=your_password
EMAIL_FROM=your@email.com
EMAIL_TO=recipient@email.com
EMAIL_SUBJECT=Voyix POS Test Results
