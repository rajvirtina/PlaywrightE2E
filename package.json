{
  "name": "voyix-pos-test-automation",
  "version": "1.0.0",
  "description": "Automated end-to-end and performance test suite for Voyix POS.",
  "keywords": [
    "playwright",
    "cucumber",
    "test-automation",
    "voyix-pos"
  ],
  "license": "MIT",
  "author": "Voyix QA",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "spectest": "./bin/spectest.js"
  },
  "files": [
    "dist",
    "bin",
    "scripts/postinstall.js",
    "!dist/**/*.test.js",
    "!dist/**/__tests__",
    "!dist/**/*.map"
  ],
  "scripts": {
    "test:e2e": "node --env-file=.env run-e2e.js",
    "test:hardware": "node --env-file=.env.hardware run-e2e.js",
    "test:jira": "node --env-file=.env run-e2e.js --tags",
    "test:tag": "node --env-file=.env run-e2e.js --tags",
    "test:case": "node --env-file=.env run-e2e.js --tags",
    "report": "node --env-file=.env generate-report.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.2.0",
    "@vitest/ui": "^3.2.4",
    "husky": "^9.1.7",
    "multiple-cucumber-html-reporter": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@inquirer/core": "^10.2.2",
    "@inquirer/prompts": "^7.8.0",
    "chalk": "^5.5.0",
    "commander": "^14.0.0",
    "nodemailer": "^9.0.1",
    "ora": "^8.2.0",
    "zod": "^4.0.17"
  }
}
